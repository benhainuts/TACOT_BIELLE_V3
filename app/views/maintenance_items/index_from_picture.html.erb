<h1>Nous allons créer les entretiens suivants pour votre voiture :</h1>
<p>voiture <%=@car.make%> <%=@car.model%> <%=@car.energy%></p>

<form action=<%=car_maintenance_items_path(@car)%> method="post">
  <%@maintenance_items.each do |item|%>
    <li>
      <ul><input type="checkbox" id=<%=:item_name%>><%=item[:item_name]%> ; <%=item[item_source]%></ul>
    </li>
  <%end%>

  <%raise%>
</form>
